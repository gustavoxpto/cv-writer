# Secrets — backstop only, see docs/security.md for the real control
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
!secrets/**/*.enc.*

# Personal local Claude Code overrides (per-machine, not team config)
.claude/settings.local.json

# OS
desktop.ini
Thumbs.db
.DS_Store

# Editors
.vscode/
.idea/

# Dependencies / build output (uncomment/extend once a language is chosen)
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# CV Writer personal data — real contact details + employment history, never versioned.
# data/profile.example.yaml is the committed reference (fake data) and is explicitly kept.
data/*
!data/.gitkeep
!data/profile.example.yaml

# CV Writer local SQLite DB + generated CV output (personal data, spec criterion 31)
*.sqlite3
output/

# Scratch review artifacts and one-off fixer scripts. These accumulate at the repo root during
# sessions; ignored rather than removed, per CLAUDE.md hard rule #1 (deletion needs fresh,
# explicit, per-action permission). Clear them out deliberately, not incidentally.
tmp_review_*.txt
wc_diff_review_*.txt
ruff_tmp.txt
fix_lint_tmp.py

# Claude Code worktrees — a full second copy of the repo, per-machine, never versioned.
.claude/worktrees/

# The bypass token. Its presence disables a blocking hook for one action; it is deliberately
# local and short-lived, and every use is logged to .specs/STATE.md regardless.
.specs/BYPASS
