<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>{{ title }}</title>
<style>
  /* Criterion 26: black text on white, no colour/shading; ATS-safe single-column structure;
     one documented-shortlist font (see render_html.py's FONT_SHORTLIST), >=10pt body, no
     webfonts (this references a locally-installed system font by name only — see ADR 0004
     decision 4 for why no font file is bundled in this repo). */
  @page {
    size: A4;
    margin: 20mm 18mm;
  }
  body {
    font-family: Arial, Helvetica, sans-serif;
    font-size: 11pt;
    line-height: 1.4;
    color: #000000;
    background: #ffffff;
    margin: 0;
  }
  h1 {
    font-size: 16pt;
    font-weight: bold;
    margin: 0 0 4pt 0;
  }
  h2 {
    font-size: 12pt;
    font-weight: bold;
    margin: 12pt 0 4pt 0;
    border-bottom: 1pt solid #000000;
    padding-bottom: 2pt;
  }
  p {
    margin: 0 0 4pt 0;
  }
  ul {
    margin: 0 0 8pt 18pt;
    padding: 0;
  }
  li {
    margin-bottom: 2pt;
  }
</style>
</head>
<body>
{{ body | safe }}
</body>
</html>
